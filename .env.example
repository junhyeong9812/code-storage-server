# =============================================================================
# CTS 환경 변수
# =============================================================================

# Server
HOST=127.0.0.1
PORT=8080

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cts

# Storage (Blob 파일 저장 경로)
STORAGE_PATH=./storage

# Auth (JWT 서명 비밀키 — 운영에서는 반드시 강한 값으로 설정)
JWT_SECRET=change-me-to-a-long-random-secret

# Logging
RUST_LOG=debug
